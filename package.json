{
  "name": "spv3-loader",
  "description": "Automate commit messages quality, changelog generation, and release creation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "onFail": "error",
      "name": "node",
      "version": "24.22.1"
    }
  },
  "scripts": {
    "build": "dotnet build && dotnet build -c:Release",
    "lint": "eslint --cache",
    "postinstall": "husky",
    "publish": "dotnet restore src -t:PublishAll",
    "release": "semantic-release --debug",
    "restore": "dotnet restore && dotnet restore -p:Configuration=Release",
    "test": "dotnet test"
  },
  "homepage": "https://github.com/HaloSPV3/SPV3.Loader#readme",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@halospv3/hce.shared-config": "^3.13.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "@yarnpkg/sdks": "^3.3.1",
    "commitlint": "^21.2.4",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "semantic-release": "^26.0.0-beta.5",
    "semantic-release-export-data": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "resolutions": {
    "@semantic-release/release-notes-generator@npm:^14.1.0": "npm:15.0.0-beta.3",
    "@yarnpkg/core@npm:^4.9.1": "npm:4.9.1",
    "import-from-esm@npm:^2.0.0": "patch:import-from-esm@npm%3A2.0.0#~/.yarn/patches/import-from-esm-npm-2.0.0-8866147795.patch"
  },
  "allowScripts": {
    "@halospv3/hce.shared-config": false
  }
}
