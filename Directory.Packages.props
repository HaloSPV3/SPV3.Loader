<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NeedsSystemTextJsonPackage>$([System.Text.RegularExpressions.Regex]::IsMatch('$(TargetFramework)', 'netstandard|net4'))</NeedsSystemTextJsonPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="GitVersion.MsBuild" Version="6.8.2" />
    <PackageVersion Include="HXE" Version="3.2.0" />
    <PackageVersion Include="MahApps.Metro" Version="2.4.11" />
    <PackageVersion Include="Meziantou.Polyfill" Version="1.0.169" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeFixes" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Semver" Version="3.0.0" />

    <PackageVersion Include="Costura.Fody" Version="6.2.0" />
    <PackageVersion Condition="$(NeedsSystemTextJsonPackage)" Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="HXE">
    <!-- <PackageVersion Include="GitVersion.MsBuild" Version="6.8.2" /> -->
    <!-- <PackageVersion Include="MahApps.Metro" Version="2.4.11" /> -->
    <!-- <PackageVersion Include="Meziantou.Polyfill" Version="1.0.169" /> -->
    <!-- <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" /> -->
    <!-- <PackageVersion Include="Roslynator.CodeFixes" Version="5.0.1" /> -->
    <!-- <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" /> -->
    <!-- <PackageVersion Include="Semver" Version="3.0.0" /> -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="BinToss.XmlSourceGenerator" Version="2.0.1" />
    <PackageVersion Include="BinToss.XmlSourceGenerator.Abstractions" Version="2.0.1" />
    <PackageVersion Condition="$(NeedsSystemTextJsonPackage)" Include="StandardSocketsHttpHandler" Version="2.2.0.10" />
    <PackageVersion Condition="$(NeedsSystemTextJsonPackage)" Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="LinuxDesktopUtils.XDGDesktopPortal" Version="1.0.2" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>
</Project>
